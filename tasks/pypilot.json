// PyPilot task templates (F6).
//
// Zed extensions cannot register custom command-palette entries, so the palette
// surface is provided through tasks: `task: spawn` lists these by label.
//
// Install by copying into either:
//   * global  — ~/.config/zed/tasks.json   (Windows: %APPDATA%\Zed\tasks.json)
//   * project — <workspace>/.zed/tasks.json
//
// Labels mirror the F5 toast buttons so the two surfaces map 1:1:
//   "Fix everything" → pypilot setup   (identical code path)
//   "Show details"   → pypilot doctor  (same assessment, read-only)
//
// We deliberately pass NO `--path`: Zed sets `cwd` to the worktree root and
// pypilot defaults to the current directory, so paths containing spaces can
// never be split by shell word-splitting.
//
// Windows notes (speed + correctness):
//   * If task spawn fails with "os error 193 (%1 is not a valid Win32
//     application)", the shell resolved to a 0-byte Microsoft Store package
//     stub. Never use a bare "pwsh.exe"; pin the App Execution Alias instead:
//       %LOCALAPPDATA%\Microsoft\WindowsApps\pwsh.exe
//     It is a reparse point Windows retargets on every PowerShell update, so it
//     is version-independent with zero lookup cost.
//   * Add -NoProfile so task spawns skip the interactive profile — roughly
//     halves shell startup when the profile runs prompt/banner tooling:
//       "shell": {
//         "with_arguments": {
//           "program": "C:\\Users\\<you>\\AppData\\Local\\Microsoft\\WindowsApps\\pwsh.exe",
//           "args": ["-NoProfile"]
//         }
//       }
[
  {
    "label": "pypilot: fix everything (set up environment)",
    "command": "pypilot",
    "args": ["setup"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "save": "all",
    "reveal": "always"
  },
  {
    "label": "pypilot: show details (doctor report)",
    "command": "pypilot",
    "args": ["doctor"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]
